<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd user agent. Install:
    cp contrib/com.github.muster-social.plist ~/Library/LaunchAgents/
    # edit ProgramArguments to the absolute path of muster-social, and YOU in the log paths below
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.github.muster-social.plist
  Stop:  launchctl bootout gui/$(id -u)/com.github.muster-social
  Logs:  ~/Library/Logs/muster-social.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.muster-social</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/muster-social</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <!-- launchd does not expand ~: replace YOU with your macOS user name -->
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/muster-social.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/muster-social.log</string>
</dict>
</plist>
